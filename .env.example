# TeaLeaf Field Scout web — environment variables.
#
# Every VITE_* value is compiled into the JavaScript bundle and is readable by anyone
# who opens the site. NEVER put passwords, API keys, client secrets or token-signing
# keys here.
#
# Copy to `.env.local` (git-ignored) and adjust.

# Where data comes from (required):
#   fixtures — synthetic, relational demo data held in the browser. The UI shows
#              "Demo data" indicators and development-only sign-in accounts.
#   api      — the TeaLeaf API Gateway. Fixture data and fixture accounts are not
#              loaded at all, and failed requests are shown as errors (never replaced
#              with fixture data).
VITE_DATA_SOURCE=fixtures

# API Gateway base URL including the version prefix (required when VITE_DATA_SOURCE=api).
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Request timeout in milliseconds (optional, default 15000).
# VITE_API_TIMEOUT_MS=15000
